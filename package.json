{
  "name": "claude-plans",
  "version": "0.0.3",
  "private": true,
  "description": "A planning studio for plans made with Claude.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "format": "prettier --write . && node scripts/launcher/launch.ts python -m ruff format",
    "format:check": "prettier --check . && node scripts/launcher/launch.ts python -m ruff format --check",
    "lint": "npm run lint:code && npm run lint:markdown && npm run lint:python",
    "lint:code": "eslint --max-warnings 0 .",
    "lint:markdown": "markdownlint-cli2",
    "lint:python": "node scripts/launcher/launch.ts python -m ruff check",
    "setup:python": "node scripts/launcher/launch.ts setup",
    "test": "npm run test:node && npm run test:python",
    "test:node": "node scripts/launcher/launch.ts node --time-limit 30 node_modules/vitest/vitest.mjs run --coverage",
    "test:python": "node scripts/launcher/launch.ts python --time-limit 30 -m pytest",
    "typecheck": "tsc --project tsconfig.json && npm run typecheck:python",
    "typecheck:python": "node scripts/launcher/launch.ts python -m mypy"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.4",
    "@vitest/coverage-v8": "^5.1.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.5.5",
    "eslint-plugin-tsdoc": "^0.5.4",
    "markdownlint-cli2": "^0.24.2",
    "prettier": "^3.10.1",
    "typescript": "~6.0",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}
