// The tools' configuration files. The scripts and each package have projects of their own.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Vitest's types for its settings name the browser's types.
    "lib": ["es2024", "dom"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": ["*.js", "*.ts"]
}
