{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    // Node.js runs the TypeScript scripts directly, so they use only syntax it can strip.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": ["*.js", "*.ts", "scripts/**/*.ts"]
}
