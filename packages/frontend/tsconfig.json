{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The page runs in a browser, and Vite builds it.
    "lib": ["es2024", "dom", "dom.iterable"],
    "types": ["vite/client"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", ".storybook/*.ts", "*.ts"]
}
