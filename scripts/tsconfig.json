{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // Node.js runs the TypeScript scripts directly, so they use only syntax it can strip.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": ["**/*.ts"],
  // It has a project of its own.
  "exclude": ["slow-tests"]
}
